{% extends '@theme/layout.twig' %}
{% set page_title = entry.field('title') ~ ' — Research — Sara Bonella' %}
{% set meta_description = entry.field('summary')|default('A research area within Sara Bonella’s work in computational physics.', true) %}
{% set og_title = page_title %}
{% set og_description = meta_description %}
{% set body_class = 'page-research' %}

{% block content %}
    {% set hero_kind = 'research-detail' %}
    {% set hero_canvas = true %}
    {% set hero_eyebrow = entry.field('category')|default('Research note', true) %}
    {% set hero_title = entry.field('title') %}
    {% set hero_deck = entry.field('summary')|default('A focused question within Sara Bonella’s work on matter, motion, and computational method.', true) %}
    {% set hero_roles = [] %}
    {% set hero_primary_url = 'mailto:sara.bonella@epfl.ch?subject=Research%20collaboration' %}
    {% set hero_primary_label = 'Discuss the work' %}
    {% set hero_secondary_url = '/research' %}
    {% set hero_secondary_label = 'All research areas' %}
    {% set hero_caption = 'Underdamped Langevin particles crossing a double-well free-energy landscape' %}
    {% set hero_source_url = 'https://doi.org/10.1063/5.0169050' %}
    {% include '@theme/orbital-hero.twig' %}

    <article class="article-shell">
        <p class="eyebrow">Research note</p>
        <div class="article-body">{{ entry.field('body')|markdown }}</div>
        <div class="action-row"><a class="text-action" href="/research">Return to research <span aria-hidden="true">→</span></a></div>
    </article>
{% endblock %}
