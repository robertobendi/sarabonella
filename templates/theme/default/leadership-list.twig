{% extends '@theme/layout.twig' %}
{% set page_title = 'Teaching & community — Sara Bonella' %}
{% set meta_description = 'Sara Bonella’s teaching, mentoring, CECAM leadership, open scientific tools, training, and public engagement.' %}
{% set og_title = page_title %}
{% set og_description = meta_description %}
{% set body_class = 'page-leadership' %}

{% block content %}
    {% set hero_kind = 'leadership' %}
    {% set hero_canvas = true %}
    {% set hero_field = 'synchrony' %}
    {% set hero_simulation_title = 'Coupled oscillators' %}
    {% set hero_simulation_caption = 'Oscillators fall into step as the coupling rises and drift apart as it falls. Move the pointer to couple the ones nearby.' %}
    {% set hero_simulation_source_url = 'https://www.cecam.org/lausanne-hq' %}
    {% set hero_simulation_source_label = 'CECAM, Lausanne' %}
    {% set hero_ring_text = '' %}
    {% set hero_image = '/uploads/home-hero/epfl_campus___lausanne__36780868741__jpg.jpg' %}
    {% set hero_alt = 'Research buildings and a tree-lined road on the EPFL campus in Lausanne' %}
    {% set hero_caption = 'EPFL campus, Lausanne' %}
    {% set hero_source_url = 'https://commons.wikimedia.org/wiki/File:EPFL_Campus_-_Lausanne_(36780868741).jpg' %}
    {% set hero_eyebrow = 'Teaching & community' %}
    {% set hero_title = 'Teaching, supervision, and CECAM' %}
    {% set hero_deck = 'Alongside her research, Sara teaches, supervises doctoral students, develops open tools, and runs scientific programmes and training.' %}
    {% set hero_roles = ['Deputy Director / CECAM since 2014', 'Senior Scientist & lecturer / EPFL', 'PhD programme committee / Physics, EPFL'] %}
    {% set hero_primary_url = 'mailto:sara.bonella@epfl.ch?subject=Speaking%20or%20institutional%20invitation' %}
    {% set hero_primary_label = 'Invite Sara' %}
    {% set hero_secondary_url = '#cecam' %}
    {% set hero_secondary_label = 'Read the story' %}
    {% set hero_nodes = [] %}
    {% include '@theme/orbital-hero.twig' %}

    <section class="section" id="cecam" aria-labelledby="cecam-title">
        <div class="collective-grid shell">
            <div>
                <p class="eyebrow">CECAM · since 2014</p>
                <h2 id="cecam-title">Deputy Director of CECAM</h2>
            </div>
            <div class="bio-copy">
                <p>As Deputy Director of CECAM, Sara works where research strategy meets daily scientific life: programmes, workshops, training, infrastructure, international partnerships, and the conversations that let new collaborations begin.</p>
                <p>She describes this work as a way of giving something back to the institutions and people that help scientists grow. It also asks a different kind of research question: what structures help a distributed community do better science?</p>
                <p class="source-note"><a href="https://www.cecam.org/lausanne-hq" target="_blank" rel="noopener">CECAM Lausanne Headquarters</a> · <a href="https://nccr-marvel.ch/outreach/equal-opportunities/women-profiles/sara-bonella" target="_blank" rel="noopener">Interview with Sara</a></p>
            </div>
        </div>
    </section>

    <section class="section section--field" id="teaching" aria-labelledby="teaching-title">
        <div class="teaching-grid shell">
            <div>
                <p class="eyebrow">At EPFL</p>
                <h2 id="teaching-title">Courses and supervision at EPFL</h2>
                <p class="section-deck" style="margin-top:1.4rem;">Formal results meet computation, code, and physical interpretation. The aim is not only to know a method, but to understand what it can and cannot tell us.</p>
            </div>
            <div class="course-list">
                <article class="course-item"><small>CH-452</small><h3>Computational Methods in Molecular Quantum Mechanics</h3><p>Time-dependent molecular quantum properties, density functional theory, nuclear quantum effects, and adiabatic and non-adiabatic dynamics.</p></article>
                <article class="course-item"><small>PHYS-729</small><h3>Non-equilibrium Statistical Mechanics Simulations</h3><p>Non-equilibrium theory, computational algorithms, coding exercises, and the physics of open systems.</p></article>
                <article class="course-item"><small>Doctoral mentoring</small><h3>Supporting original research at EPFL</h3><p>Supervision joins rigorous method development with physical interpretation, collaboration, and growing scientific independence.</p></article>
            </div>
        </div>
    </section>

    <section class="section section--plum section--portrait" aria-labelledby="travel-title">
        <div class="collective-grid shell">
            <div><p class="eyebrow">Across borders</p><h2 id="travel-title">Teaching outside Switzerland</h2></div>
            <div class="collective-copy">
                <p>Sara has taught students and researchers across Europe, the United States, and Africa. Recent work includes statistical-mechanics and molecular-dynamics teaching in Rwanda and the 2026 ICTP–MARVEL College on materials simulations in the age of AI.</p>
                <div class="collective-facts">
                    <div class="collective-fact"><span>Lausanne</span><strong>Master’s and doctoral teaching at EPFL</strong></div>
                    <div class="collective-fact"><span>Kigali</span><strong>Statistical mechanics and molecular dynamics</strong></div>
                    <div class="collective-fact"><span>Trieste · 2026</span><strong>Materials simulations in the age of AI</strong></div>
                </div>
            </div>
        </div>
        {% include '@theme/section-portrait.twig' %}
    </section>

    <section class="section section--ornamented" id="public" aria-labelledby="public-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div><p class="eyebrow">Open tools &amp; public science</p><h2 id="public-title">Open tools and public engagement</h2></div>
                <p class="section-deck">Scientific ideas live longer when people can use them, question them, teach them, and tell stories about them.</p>
            </div>
            <div class="selected-work">
                <article class="selected-paper"><time>01</time><div><h3>OSSCAR</h3><p>An open platform for collaborative computational tools and interactive science education.</p></div><a href="https://www.osscar.org/" target="_blank" rel="noopener">Explore ↗</a></article>
                <article class="selected-paper"><time>02</time><div><h3>Mary Ann Mansigh Conversations</h3><p>Public conversations with people who have shaped computational science, technology, and its wider culture.</p></div><a href="https://nccr-marvel.ch/outreach/education-and-training/mary-ann-mansigh-conversations" target="_blank" rel="noopener">Explore ↗</a></article>
                <article class="selected-paper"><time>03</time><div><h3>Science in comics</h3><p>Stories about simulation, high-performance computing, and women’s participation in science for readers beyond the field.</p></div><a href="mailto:sara.bonella@epfl.ch?subject=Science%20communication%20enquiry">Ask Sara →</a></article>
            </div>
        </div>
        {% include '@theme/scientific-ornament.twig' with {
            ornament_kind: 'phase',
            ornament_class: 'science-ornament--left',
            ornament_title: 'Conservative Duffing portrait',
            ornament_formula: 'H(q,p) = const.',
            ornament_description: 'Closed trajectories follow a conserved Hamiltonian around two stable centres and a central saddle.'
        } %}
    </section>

    <section class="contact-invitation" aria-labelledby="invite-title">
        <div class="contact-invitation__grid shell">
            <div><p class="eyebrow">Invitations</p><h2 id="invite-title">Invitations and speaking</h2><p>Include the audience, format, timing, and the scientific or institutional topic.</p></div>
            <a class="button" href="mailto:sara.bonella@epfl.ch?subject=Speaking%20or%20institutional%20invitation">Write to Sara</a>
        </div>
    </section>
{% endblock %}
