{% extends '@theme/layout.twig' %}
{% set page_title = 'Leadership & teaching — Sara Bonella' %}
{% set meta_description = 'Sara Bonella builds scientific capacity through CECAM leadership, international networks, university teaching, training, and supervision.' %}
{% set og_title = 'Leadership & teaching — Lead, connect, teach' %}
{% set og_description = meta_description %}
{% set body_class = 'page-leadership' %}

{% block content %}
    {% set hero_kind = 'leadership' %}
    {% set hero_ring_text = 'LEAD • CONNECT • TEACH • CECAM •' %}
    {% set hero_image = '/uploads/research-hero/oak_ridge___kraken__cray_xt5__jpg.jpg' %}
    {% set hero_alt = 'Kraken Cray XT5 supercomputer cabinets at Oak Ridge' %}
    {% set hero_caption = 'Kraken Cray XT5 — infrastructure context, not a CECAM facility' %}
    {% set hero_source_url = 'https://commons.wikimedia.org/wiki/File:Oak_Ridge_-_Kraken_Cray_XT5.jpg' %}
    {% set hero_eyebrow = '03 / CAPACITY BUILDING' %}
    {% set hero_title = 'Scientific leadership is infrastructure for better questions' %}
    {% set hero_deck = 'Bonella’s work at CECAM and EPFL connects research programmes, computational infrastructure, teaching, supervision, and international scientific communities.' %}
    {% set hero_roles = ['Deputy Director / CECAM since 2014', 'Maître d’Enseignement et de Recherche / EPFL', 'Teacher & supervisor / Europe, USA & Africa'] %}
    {% set hero_primary_url = 'mailto:sara.bonella@epfl.ch?subject=Speaking%20or%20institutional%20invitation' %}
    {% set hero_primary_label = 'Issue an invitation' %}
    {% set hero_secondary_url = '#timeline' %}
    {% set hero_secondary_label = 'Follow the trajectory' %}
    {% set hero_nodes = [
        {'label': 'CECAM', 'url': '#timeline', 'lime': true},
        {'label': 'Research networks', 'url': '#networks'},
        {'label': 'Scientific programmes', 'url': '#programmes'},
        {'label': 'Teaching', 'url': '#teaching'},
        {'label': 'Supervision', 'url': '#teaching'}
    ] %}
    {% include '@theme/orbital-hero.twig' %}

    <section class="section section--large" id="timeline" aria-labelledby="timeline-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div>
                    <p class="eyebrow">04 / CECAM TRAJECTORY</p>
                    <h2 id="timeline-title">A programme line that begins in 2014</h2>
                </div>
                <p class="section-deck">The role combines scientific judgement with the work of keeping a distributed research community connected: programme definition, collaboration, projects, funding, international representation, training, and outreach.</p>
            </div>
            <div class="timeline">
                <article class="timeline-stop"><time datetime="2014">2014</time><p>Begins as Deputy Director of CECAM Headquarters at EPFL.</p></article>
                <article class="timeline-stop"><time datetime="2016">2016</time><p>Joins E-CAM coordination and leads work in quantum dynamics and industry relationships.</p></article>
                <article class="timeline-stop"><time datetime="2021">2021</time><p>Joins the LUMI Scientific Advisory Group and Materials Cloud Executive Committee.</p></article>
                <article class="timeline-stop"><time datetime="2023">2023</time><p>Serves on the steering committee of the EU Centre of Excellence MultiXscale.</p></article>
                <article class="timeline-stop"><time datetime="2025">2025—</time><p>Joins the CNRS physics scientific council and begins invited teaching in Rwanda.</p></article>
            </div>
            <p class="source-note" style="margin-top:1.5rem;">Milestones are drawn from the supplied July 2026 academic record. Status language is kept descriptive rather than contractual.</p>
        </div>
    </section>

    <section class="section section--large section--plum" id="networks" aria-labelledby="networks-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div>
                    <p class="eyebrow">05 / NETWORK NODES</p>
                    <h2 id="networks-title">Institutions connected by responsibility, not a logo strip</h2>
                </div>
                <p class="section-deck">Node size signals narrative emphasis only; it does not imply organisational scale, funding, or hierarchy.</p>
            </div>
            <div class="network-orbit" aria-label="Scientific networks and committees">
                <div class="network-node">LUMI<br>Scientific Advisory Group</div>
                <div class="network-node">Materials<br>Cloud</div>
                <div class="network-node">NCCR MARVEL<br>Executive Committee</div>
                <div class="network-node">MultiXscale<br>Steering Committee</div>
                <div class="network-node">CNRS<br>Physics Council</div>
                <div class="network-node">EPFL Physics<br>Doctoral Committee</div>
            </div>
        </div>
    </section>

    <figure class="network-photo-band">
        <img src="/uploads/home-hero/epfl_campus___lausanne__36780868741__jpg.jpg" alt="Road and research buildings on the EPFL campus in Lausanne">
        <figcaption>EPFL campus context, Lausanne. <a href="https://commons.wikimedia.org/wiki/File:EPFL_Campus_-_Lausanne_(36780868741).jpg" target="_blank" rel="noopener">Wikimedia source</a></figcaption>
    </figure>

    <section class="section section--large" id="programmes" aria-labelledby="programmes-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div>
                    <p class="eyebrow">06 / PROGRAM EVIDENCE</p>
                    <h2 id="programmes-title">Roles, resources, and a visible verification state</h2>
                </div>
                <p class="section-deck">Public funding figures are useful evidence only when attribution is current. The values below are reproduced from the supplied CV and remain explicitly marked for pre-launch verification.</p>
            </div>
            <div class="table-wrap" tabindex="0" aria-label="Funding and programme record; horizontally scrollable on small screens">
                <table class="evidence-table">
                    <thead><tr><th>Year</th><th>Programme</th><th>Role</th><th>Amount / currency</th><th>Status</th></tr></thead>
                    <tbody>
                        <tr><td>2025</td><td>CECAM infrastructure for research, education, and networking / SNSF</td><td>Co-PI</td><td>672,000 CHF total</td><td><span class="verify-tag">Source CV / verify</span></td></tr>
                        <tr><td>2023</td><td>Fluxionic / MSCA Doctoral Network</td><td>Co-PI</td><td>250,000 CHF personal funding</td><td><span class="verify-tag">Source CV / verify</span></td></tr>
                        <tr><td>2023</td><td>AITranspWood</td><td>PI</td><td>600,000 CHF</td><td><span class="verify-tag">Source CV / verify</span></td></tr>
                        <tr><td>2021</td><td>NCCR MARVEL / Work Package 3</td><td>PI</td><td>360,000 CHF specific funding</td><td><span class="verify-tag">Source CV / verify</span></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="section section--large section--field" id="teaching" aria-labelledby="teaching-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div>
                    <p class="eyebrow">07 / TEACHING &amp; SUPERVISION</p>
                    <h2 id="teaching-title">Methods become capacity when people can use them critically</h2>
                </div>
                <p class="section-deck">Bonella has taught Bachelor, Master, and doctoral courses in Europe, the United States, and Africa, and supervised postdoctoral fellows and students across physics and chemistry.</p>
            </div>
            <div class="course-orbit">
                <article class="course-strip"><time>2026</time><strong>Non-equilibrium Statistical Mechanics Simulations</strong><span class="course-place">PhD Physics / EPFL</span></article>
                <article class="course-strip"><time>2015—</time><strong>Computational Methods in Molecular Quantum Dynamics</strong><span class="course-place">Master / EPFL</span></article>
                <article class="course-strip"><time>2025—</time><strong>Statistical Mechanics</strong><span class="course-place">EAIFR / University of Rwanda</span></article>
            </div>
            <div class="evidence-grid" style="margin-top:4rem;">
                <article class="instrument-card accent-cyan">
                    <div class="card-meta"><span class="card-coordinate">T.01 / SUPERVISION</span><span>Across stages</span></div>
                    <h3>From first research project to independent scholar</h3>
                    <p>The supplied record documents supervision of postdoctoral fellows, doctoral researchers, and master’s students across physics and chemistry.</p>
                </article>
                <article class="instrument-card accent-pink">
                    <div class="card-meta"><span class="card-coordinate">T.02 / INTERNATIONAL</span><span>Rwanda / Europe / USA</span></div>
                    <h3>Teaching across institutional contexts</h3>
                    <p>Invited courses range from molecular dynamics and computational statistical mechanics to quantum dynamics and the history of quantum mechanics.</p>
                </article>
                <article class="instrument-card accent-lime">
                    <div class="card-meta"><span class="card-coordinate">T.03 / OPEN TOOLS</span><span>OSSCAR / Lhumos</span></div>
                    <h3>Training that remains available after the room empties</h3>
                    <p>Bonella has coordinated development of thematic training platforms and contributed to open computational tools for science education.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="section section--large" aria-labelledby="leadership-contact-title">
        <div class="shell">
            <div class="invitation-panel">
                <div>
                    <p class="eyebrow">08 / INVITATION ROUTE</p>
                    <h2 id="leadership-contact-title">Invite a talk / build a programme / strengthen a training network</h2>
                    <p class="section-deck">Include the audience, format, timing, and the scientific or institutional question you want the exchange to address.</p>
                    <div class="action-row" style="margin-top:2rem;"><a class="button" href="mailto:sara.bonella@epfl.ch?subject=Speaking%20or%20institutional%20invitation">Send invitation context <span class="arrow-glyph" aria-hidden="true">↗</span></a><a class="text-action" href="/contact">View all enquiry routes</a></div>
                </div>
                <span class="sticker" aria-hidden="true"><svg viewBox="0 0 120 120"><defs><path id="invite-seal-ring" d="M60 60m-48 0a48 48 0 1 1 96 0a48 48 0 1 1-96 0"/></defs><circle cx="60" cy="60" r="53" fill="#070A18" stroke="currentColor" stroke-width="2"/><text font-size="10" letter-spacing="1.8"><textPath href="#invite-seal-ring">INVITE • CONNECT • TEACH • </textPath></text><text x="60" y="68" text-anchor="middle" font-size="24" font-weight="700">↗</text></svg></span>
            </div>
        </div>
    </section>
{% endblock %}
