{% extends '@theme/layout.twig' %}
{% set page_title = (ok ? 'Message received' : 'Message not sent') ~ ' — Sara Bonella' %}
{% set meta_description = ok ? 'Your message was received.' : 'The contact endpoint could not accept this message.' %}
{% set og_title = page_title %}
{% set og_description = meta_description %}
{% set body_class = 'page-contact' %}

{% block content %}
<section class="section section--field">
    <div class="shell" style="max-width:940px;">
        <p class="eyebrow">Contact</p>
        {% if ok %}
            <h1>Message received.</h1>
            <p class="lede" style="margin-top:1.5rem;">Thank you. Your message was accepted by the website.</p>
        {% else %}
            <h1>The message was not sent.</h1>
            {% if errors|length > 0 %}<ul>{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>{% endif %}
            <p class="lede" style="margin-top:1.5rem;">Please use Sara’s direct email instead.</p>
        {% endif %}
        <div class="action-row"><a class="button" href="mailto:sara.bonella@epfl.ch?subject=Academic%20enquiry">Write by email</a><a class="text-action" href="/contact">Contact details</a></div>
    </div>
</section>
{% endblock %}
