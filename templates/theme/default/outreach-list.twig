{% extends '@theme/layout.twig' %}
{% set page_title = 'Outreach — Sara Bonella' %}
{% set meta_description = 'Explore Sara Bonella’s work in public science, open computational training, science communication, and wider participation in STEM.' %}
{% set og_title = 'Outreach — Science shared and open' %}
{% set og_description = meta_description %}
{% set body_class = 'page-outreach' %}

{% block content %}
    {% set hero_kind = 'outreach' %}
    {% set hero_ring_text = 'SCIENCE • SHARED • OPEN • TOGETHER •' %}
    {% set hero_image = '/uploads/outreach-hero/flickr___official_u_s__navy_imagery___an_instructor_from_the.jpg' %}
    {% set hero_alt = 'Science instructor demonstrating an activity to children at a public engagement event' %}
    {% set hero_caption = 'Context image: public science engagement — not Bonella or a CECAM event' %}
    {% set hero_source_url = 'https://commons.wikimedia.org/wiki/Special:MediaSearch?type=image&search=Official%20US%20Navy%20Imagery%20instructor%20science%20students' %}
    {% set hero_eyebrow = '04 / PUBLIC SCIENCE' %}
    {% set hero_title = 'Computational science becomes stronger when it can be shared' %}
    {% set hero_deck = 'Public engagement, open tools, international training, and wider participation are not side projects: they are part of how a scientific community renews itself.' %}
    {% set hero_roles = ['CECAM outreach & dissemination', 'Online training / Lhumos & OSSCAR', 'Science festivals / participation in STEM'] %}
    {% set hero_primary_url = 'mailto:sara.bonella@epfl.ch?subject=Outreach%20partnership' %}
    {% set hero_primary_label = 'Propose a partnership' %}
    {% set hero_secondary_url = '#outreach-sequence' %}
    {% set hero_secondary_label = 'Explore the initiatives' %}
    {% set hero_nodes = [
        {'label': 'Public science', 'url': '#outreach-sequence'},
        {'label': 'Online training', 'url': '#outreach-sequence'},
        {'label': 'Open tools', 'url': '#comics'},
        {'label': 'Women in STEM', 'url': '#participation'},
        {'label': 'International teaching', 'url': '#initiatives', 'lime': true}
    ] %}
    {% include '@theme/orbital-hero.twig' %}

    <section class="section section--large" id="outreach-sequence" aria-labelledby="outreach-sequence-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div>
                    <p class="eyebrow">05 / CONNECTED PROGRAMME</p>
                    <h2 id="outreach-sequence-title">From specialist knowledge to shared capability</h2>
                </div>
                <p class="section-deck">The sequence moves outward: from CECAM’s scientific network, to training resources, to open education, and finally to public conversations about simulation and who participates in science.</p>
            </div>
            <div class="program-sequence">
                <article class="program-beat">
                    <p class="eyebrow">O.01 / CECAM</p>
                    <h3>Outreach within a research network</h3>
                    <p>Coordinating dissemination and public-facing activity alongside CECAM’s scientific programme.</p>
                </article>
                <article class="program-beat">
                    <p class="eyebrow">O.02 / TRAINING</p>
                    <h3>Advanced learning online</h3>
                    <p>Developing thematic training and online formats for computational projects, HPC, and specialist communities.</p>
                </article>
                <article class="program-beat">
                    <p class="eyebrow">O.03 / OPEN TOOLS</p>
                    <h3>Resources that remain usable</h3>
                    <p>Contributing to Lhumos and OSSCAR so computational concepts can be explored beyond a single course or event.</p>
                </article>
                <article class="program-beat">
                    <p class="eyebrow">O.04 / PUBLIC</p>
                    <h3>Simulation as a public story</h3>
                    <p>Science-festival speaking and comics on HPC, modelling, simulation, and female participation in STEM.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="section section--large section--plum" id="comics" aria-labelledby="comics-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div>
                    <p class="eyebrow">06 / SCIENCE COMICS</p>
                    <h2 id="comics-title">Two stories: what models reveal / who gets to model</h2>
                </div>
                <p class="section-deck">These are original interpretive panels—not replicas of supplied covers. They echo the two documented comic themes without inventing titles or artwork.</p>
            </div>
            <figure class="comics-plate">
                <svg viewBox="0 0 1200 600" role="img" aria-labelledby="comics-svg-title comics-svg-desc">
                    <title id="comics-svg-title">Original two-panel illustration about simulation and participation in science</title>
                    <desc id="comics-svg-desc">The first panel shows particles moving through a computational field. The second shows three scientists around an open orbit.</desc>
                    <defs>
                        <pattern id="comic-dots" width="12" height="12" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r="2" fill="#070A18" opacity=".58"/></pattern>
                        <clipPath id="comic-left"><polygon points="0,0 570,0 600,30 600,600 0,600"/></clipPath>
                        <clipPath id="comic-right"><polygon points="620,0 1170,0 1200,30 1200,600 620,600"/></clipPath>
                    </defs>
                    <g clip-path="url(#comic-left)">
                        <rect width="600" height="600" fill="#00D9FF"/>
                        <rect x="12" y="12" width="600" height="600" fill="#FF4FCB" opacity=".34"/>
                        <rect width="600" height="600" fill="url(#comic-dots)" opacity=".5"/>
                        <path d="M42 410C160 105 337 510 560 155" fill="none" stroke="#F5F2FF" stroke-width="12" stroke-dasharray="4 18"/>
                        <g fill="#B8FF3E" stroke="#070A18" stroke-width="6"><circle cx="105" cy="340" r="34"/><circle cx="235" cy="220" r="25"/><circle cx="350" cy="370" r="48"/><circle cx="500" cy="205" r="31"/></g>
                        <text x="45" y="72" font-family="Space Mono, monospace" font-size="18" fill="#070A18" letter-spacing="3">PANEL 01 / SIMULATION</text>
                        <text x="45" y="530" font-family="Syne, sans-serif" font-size="56" font-weight="700" fill="#070A18">WHAT CAN</text>
                        <text x="45" y="584" font-family="Syne, sans-serif" font-size="56" font-weight="700" fill="#070A18">WE SEE?</text>
                    </g>
                    <g clip-path="url(#comic-right)" transform="translate(-7 4)">
                        <rect x="620" width="580" height="600" fill="#5B4BFF"/>
                        <rect x="632" y="-8" width="580" height="600" fill="#FF4FCB" opacity=".35"/>
                        <rect x="620" width="580" height="600" fill="url(#comic-dots)" opacity=".52"/>
                        <ellipse cx="910" cy="315" rx="225" ry="112" fill="none" stroke="#00D9FF" stroke-width="10" stroke-dasharray="4 18" transform="rotate(-18 910 315)"/>
                        <g stroke="#070A18" stroke-width="7">
                            <circle cx="770" cy="270" r="51" fill="#B8FF3E"/><path d="M712 447Q770 335 828 447" fill="#F5F2FF"/>
                            <circle cx="910" cy="220" r="51" fill="#00D9FF"/><path d="M852 397Q910 285 968 397" fill="#F5F2FF"/>
                            <circle cx="1050" cy="290" r="51" fill="#FF4FCB"/><path d="M992 467Q1050 355 1108 467" fill="#F5F2FF"/>
                        </g>
                        <text x="665" y="72" font-family="Space Mono, monospace" font-size="18" fill="#F5F2FF" letter-spacing="3">PANEL 02 / PARTICIPATION</text>
                        <text x="665" y="530" font-family="Syne, sans-serif" font-size="50" font-weight="700" fill="#F5F2FF">WHO GETS</text>
                        <text x="665" y="580" font-family="Syne, sans-serif" font-size="50" font-weight="700" fill="#F5F2FF">TO ASK?</text>
                    </g>
                </svg>
                <figcaption>Original site illustration with 12px halftone rhythm and chromatic misregistration; not supplied comic cover art.</figcaption>
            </figure>
        </div>
    </section>

    <section class="section section--large section--field" id="participation" aria-labelledby="participation-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div>
                    <p class="eyebrow">07 / PARTICIPATION IN SCIENCE</p>
                    <h2 id="participation-title">Access is intellectual infrastructure</h2>
                </div>
                <p class="section-deck">Widening participation means more than visibility. It means creating routes into methods, tools, networks, and the confidence to formulate new questions.</p>
            </div>
            <div class="participation-split">
                <article class="thesis-panel">
                    <p class="eyebrow">07A / WOMEN IN STEM</p>
                    <h3>Representation belongs inside the scientific story</h3>
                    <p style="margin-top:1rem;">The supplied record documents work on diversity and inclusion programming, a science comic on female participation in STEM, and supervision within international computational-science communities.</p>
                </article>
                <article class="instrument-card accent-lime">
                    <div class="card-meta"><span class="card-coordinate">07B / INTERNATIONAL</span><span>Training</span></div>
                    <h3>Teaching across borders</h3>
                    <p>Invited teaching at EAIFR in Rwanda and courses across Europe, the USA, and Africa connect specialist methods to different institutional settings.</p>
                    <a class="card-link" href="/leadership#teaching">See teaching evidence →</a>
                </article>
            </div>
        </div>
    </section>

    <section class="section section--large" id="initiatives" aria-labelledby="initiatives-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div>
                    <p class="eyebrow">08 / SELECTED INITIATIVES</p>
                    <h2 id="initiatives-title">A vertical route through training and public science</h2>
                </div>
                <p class="section-deck">Only initiatives documented in the supplied academic record appear here; scale claims are deliberately omitted when no current public source is attached.</p>
            </div>
            <div class="ticket-list">
                <article class="ticket"><p class="eyebrow">ONGOING / CECAM</p><h3>Outreach and dissemination</h3><p>Coordination of public-facing activities and science-festival participation around modelling, simulation, and HPC.</p></article>
                <article class="ticket"><p class="eyebrow">PLATFORM / LHUMOS</p><h3>Thematic training web portal</h3><p>Coordination of a resource designed to keep specialised learning available beyond individual events.</p></article>
                <article class="ticket"><p class="eyebrow">PLATFORM / OSSCAR</p><h3>Open computational tools for education</h3><p>Contribution to a collaborative platform for computational physics and chemistry education.</p></article>
                <article class="ticket"><p class="eyebrow">2025— / RWANDA</p><h3>International graduate teaching</h3><p>Invited professorship at EAIFR, University of Rwanda, including statistical mechanics and molecular-dynamics teaching.</p></article>
            </div>
        </div>
    </section>

    <section class="section section--large" aria-labelledby="outreach-contact-title">
        <div class="shell">
            <div class="invitation-panel">
                <div>
                    <p class="eyebrow">09 / OPEN-SCIENCE CHANNEL</p>
                    <h2 id="outreach-contact-title">Propose an outreach or education partnership</h2>
                    <p class="section-deck">Educators, researchers, institutions, festivals, and journalists: include the audience, format, subject, and what you want participants to be able to understand or do.</p>
                    <div class="action-row" style="margin-top:2rem;"><a class="button" href="mailto:sara.bonella@epfl.ch?subject=Outreach%20partnership">Open the conversation <span class="arrow-glyph" aria-hidden="true">↗</span></a></div>
                </div>
                <span class="sticker sticker--lime" aria-hidden="true"><svg viewBox="0 0 120 120"><defs><path id="open-science-ring" d="M60 60m-48 0a48 48 0 1 1 96 0a48 48 0 1 1-96 0"/></defs><circle cx="60" cy="60" r="53" fill="#070A18" stroke="currentColor" stroke-width="2"/><text font-size="9" letter-spacing="1.7"><textPath href="#open-science-ring">OPEN SCIENCE • SHARED SCIENCE • </textPath></text><text x="60" y="68" text-anchor="middle" font-size="22" font-weight="700">OPEN</text></svg></span>
            </div>
        </div>
    </section>
{% endblock %}
