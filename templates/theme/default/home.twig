{% extends '@theme/layout.twig' %}
{% set page_title = 'Sara Bonella — Computational physicist at EPFL and CECAM' %}
{% set meta_description = 'Meet Sara Bonella, computational physicist, EPFL Senior Scientist, teacher, and Deputy Director of CECAM in Lausanne.' %}
{% set og_title = page_title %}
{% set og_description = meta_description %}
{% set body_class = 'page-home' %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Sara Bonella",
  "url": "https://robertobendi.github.io/sarabonella/",
  "image": "https://robertobendi.github.io/sarabonella/uploads/portrait/sara-bonella-seated.jpg",
  "description": "Computational physicist, Senior Scientist at EPFL, teacher, and Deputy Director of CECAM.",
  "jobTitle": ["Senior Scientist at EPFL", "Deputy Director of CECAM"],
  "affiliation": [
    {"@type": "Organization", "name": "EPFL", "url": "https://www.epfl.ch/"},
    {"@type": "Organization", "name": "CECAM", "url": "https://www.cecam.org/"}
  ],
  "sameAs": [
    "https://people.epfl.ch/sara.bonella?lang=en",
    "https://www.cecam.org/lausanne-hq",
    "https://nccr-marvel.ch/people/profile/sara-bonella",
    "https://orcid.org/0000-0003-4131-2513"
  ]
}
</script>
{% endblock %}

{% block content %}
    <section class="personal-hero" data-langevin-surface aria-labelledby="home-title">
        <div class="personal-hero__grid shell">
            <div class="personal-hero__copy">
                <p class="eyebrow">Computational physicist · Lausanne</p>
                <h1 id="home-title">Sara<br>Bonella</h1>
                <p class="personal-role">Physicist, teacher, and Deputy Director of CECAM.</p>
                <p class="personal-deck">Sara develops simulation methods to understand matter in motion—from quantum effects and non-equilibrium dynamics to electrochemical interfaces. At EPFL and CECAM she also teaches, supervises, and runs scientific programmes.</p>
                <div class="action-row">
                    <a class="button" href="/research">Explore the research</a>
                    <a class="text-action" href="/contact">Write to Sara <span aria-hidden="true">→</span></a>
                </div>
                <ul class="hero-credentials" aria-label="Current roles">
                    <li>Senior Scientist · EPFL</li>
                    <li>Deputy Director · CECAM</li>
                    <li>PhD programme committee · Physics, EPFL</li>
                </ul>
            </div>
        </div>

        <figure class="hero-simulation">
            {% include '@theme/hero-field.twig' with { field_kind: 'particles' } %}
            <figcaption><a href="https://nccr-marvel.ch/outreach/equal-opportunities/women-profiles/sara-bonella" target="_blank" rel="noopener">Photograph</a></figcaption>
        </figure>
    </section>

    <section class="philosophy-band" aria-labelledby="philosophy-title">
        <div class="philosophy-grid shell">
            <h2 class="philosophy-quote" id="philosophy-title">“Physics is not an exact science, it’s a science of <em>controlled approximation</em>.”</h2>
            <div class="philosophy-note">
                <p>From an interview for the NCCR MARVEL profile series on women in science.</p>
                <p class="microcopy"><a href="https://nccr-marvel.ch/outreach/equal-opportunities/women-profiles/sara-bonella" target="_blank" rel="noopener">Read the full NCCR MARVEL interview →</a></p>
            </div>
        </div>
    </section>

    <section class="section section--about" id="about" aria-labelledby="about-title">
        <div class="bio-grid shell">
            <div class="bio-lead">
                <p class="eyebrow">About Sara</p>
                <h2 id="about-title">Background and career</h2>
            </div>
            <div class="bio-copy">
                <p>Born and raised in Rome in a family shaped by the humanities, Sara considered studying history before choosing physics. During her third year at La Sapienza, a gap in her timetable led her into a simulation course. Statistical mechanics became matter in motion, and a lasting research direction began.</p>
                <p>The route from Boston back to Italy and onward to Lausanne joins method development, teaching, and service to scientific communities.</p>

                <ol class="career-timeline" data-career-timeline aria-label="Sara Bonella’s career journey">
                    <li class="career-timeline__item" data-timeline-step>
                        <details class="career-timeline__disclosure" name="career-journey" open>
                            <summary class="career-timeline__summary">
                                <span class="career-timeline__date"><time datetime="2004">2004</time></span>
                                <span class="career-timeline__heading"><strong>PhD in Physics</strong><span>Boston University</span></span>
                                <span class="career-timeline__toggle" aria-hidden="true">+</span>
                            </summary>
                            <div class="career-timeline__panel"><p>Semiclassical methods for non-adiabatic dynamics, followed by a research fellowship in Boston.</p></div>
                        </details>
                    </li>
                    <li class="career-timeline__item" data-timeline-step>
                        <details class="career-timeline__disclosure" name="career-journey">
                            <summary class="career-timeline__summary">
                                <span class="career-timeline__date"><time datetime="2004">2004</time>–<time datetime="2008">08</time></span>
                                <span class="career-timeline__heading"><strong>Research fellowships</strong><span>Boston · Pisa · Rome</span></span>
                                <span class="career-timeline__toggle" aria-hidden="true">+</span>
                            </summary>
                            <div class="career-timeline__panel"><p>Successive fellowships at Boston University, the NEST centre at Scuola Normale Superiore, and La Sapienza.</p></div>
                        </details>
                    </li>
                    <li class="career-timeline__item" data-timeline-step>
                        <details class="career-timeline__disclosure" name="career-journey">
                            <summary class="career-timeline__summary">
                                <span class="career-timeline__date"><time datetime="2008">2008</time>–<time datetime="2014">14</time></span>
                                <span class="career-timeline__heading"><strong>Research &amp; teaching</strong><span>La Sapienza · Rome</span></span>
                                <span class="career-timeline__toggle" aria-hidden="true">+</span>
                            </summary>
                            <div class="career-timeline__panel"><p>Research in computational physics, university teaching, and service as an Assistant Professor.</p></div>
                        </details>
                    </li>
                    <li class="career-timeline__item" data-timeline-step>
                        <details class="career-timeline__disclosure" name="career-journey">
                            <summary class="career-timeline__summary">
                                <span class="career-timeline__date">Since <time datetime="2014">2014</time></span>
                                <span class="career-timeline__heading"><strong>Deputy Director</strong><span>CECAM · Lausanne</span></span>
                                <span class="career-timeline__toggle" aria-hidden="true">+</span>
                            </summary>
                            <div class="career-timeline__panel"><p>Scientific programmes, workshops, training, infrastructure, partnerships, and community strategy.</p></div>
                        </details>
                    </li>
                    <li class="career-timeline__item" data-timeline-step>
                        <details class="career-timeline__disclosure" name="career-journey">
                            <summary class="career-timeline__summary">
                                <span class="career-timeline__date">Since <time datetime="2017-05">2017</time></span>
                                <span class="career-timeline__heading"><strong>Senior Scientist &amp; lecturer</strong><span>EPFL · Lausanne</span></span>
                                <span class="career-timeline__toggle" aria-hidden="true">+</span>
                            </summary>
                            <div class="career-timeline__panel"><p>Research, master’s and doctoral teaching, supervision, and service on the Physics PhD programme committee.</p></div>
                        </details>
                    </li>
                    <li class="career-timeline__item" data-timeline-step>
                        <details class="career-timeline__disclosure" name="career-journey">
                            <summary class="career-timeline__summary">
                                <span class="career-timeline__date"><time datetime="2022-05">2022</time>–<time datetime="2026-04">26</time></span>
                                <span class="career-timeline__heading"><strong>Group leader</strong><span>NCCR MARVEL</span></span>
                                <span class="career-timeline__toggle" aria-hidden="true">+</span>
                            </summary>
                            <div class="career-timeline__panel"><p>Digital infrastructure for open simulations and data, including service on MARVEL’s Executive Committee.</p></div>
                        </details>
                    </li>
                    <li class="career-timeline__item" data-timeline-step>
                        <details class="career-timeline__disclosure" name="career-journey">
                            <summary class="career-timeline__summary">
                                <span class="career-timeline__date">Since <time datetime="2025">2025</time></span>
                                <span class="career-timeline__heading"><strong>Visiting Professor</strong><span>ICTP–EAIFR · Rwanda</span></span>
                                <span class="career-timeline__toggle" aria-hidden="true">+</span>
                            </summary>
                            <div class="career-timeline__panel"><p>Graduate teaching in statistical physics and molecular dynamics at the University of Rwanda.</p></div>
                        </details>
                    </li>
                </ol>
                <p class="career-timeline__coda">Scroll to follow the route. Tab reaches every milestone; arrow keys move between them.</p>
            </div>
        </div>
        {% include '@theme/scientific-ornament.twig' with {
            ornament_kind: 'phase',
            ornament_class: 'science-ornament--about',
            ornament_title: 'Conservative Duffing portrait',
            ornament_formula: 'H(q,p) = const.',
            ornament_description: 'Closed trajectories follow a conserved Hamiltonian around two stable centres and a central saddle.'
        } %}
    </section>

    <section class="section research-feature" aria-labelledby="questions-title">
        <div class="research-feature__grid shell">
            <div>
                <p class="eyebrow">Research</p>
                <h2 id="questions-title">Three recurring questions</h2>
                <div class="question-list">
                    <article class="question-row">
                        <span>01</span>
                        <div><h3>How can simulation stay faithful to physics?</h3><p>Efficient, controlled approximations for nuclear quantum effects, non-adiabatic dynamics, and systems whose exact evolution is out of computational reach.</p></div>
                    </article>
                    <article class="question-row">
                        <span>02</span>
                        <div><h3>How can constraints become useful methods?</h3><p>Mass-Zero constrained dynamics—MaZe—turns fast electronic and polarization variables into stable algorithms for first-principles and electrochemical simulation.</p></div>
                    </article>
                    <article class="question-row">
                        <span>03</span>
                        <div><h3>What happens where materials meet?</h3><p>Statistical mechanics, rare events, charged interfaces, transport, and the non-equilibrium behaviour of condensed-phase systems.</p></div>
                    </article>
                </div>
                <div class="action-row"><a class="text-action" href="/research">Read about the research <span aria-hidden="true">→</span></a></div>
            </div>

            <aside class="research-study" aria-labelledby="research-thread-title">
                <p class="eyebrow">Across the work</p>
                <h3 id="research-thread-title">What the areas have in common</h3>
                <p class="section-deck" style="margin-top:1rem;">Different scales and systems, joined by one concern: what must a useful simulation preserve?</p>
            </aside>
        </div>
        {% include '@theme/scientific-ornament.twig' with {
            ornament_kind: 'vortex',
            ornament_class: 'science-ornament--research',
            ornament_title: 'Taylor–Green vortices',
            ornament_formula: '∇·u = 0',
            ornament_description: 'Passive tracers circulate through a periodic incompressible velocity field.'
        } %}
    </section>

    <section class="section section--plum section--portrait" aria-labelledby="collective-title">
        <div class="collective-grid shell">
            <div class="teaching-intro">
                <p class="eyebrow">CECAM</p>
                <h2 id="collective-title">Research needs shared infrastructure</h2>
            </div>
            <div class="collective-copy">
                <p>Sara’s research and her work at CECAM run alongside each other. One develops methods; the other supports the workshops, training, and infrastructure that let other groups use them.</p>
                <div class="collective-facts">
                    <div class="collective-fact"><span>CECAM</span><strong>Deputy Director since 2014</strong></div>
                    <div class="collective-fact"><span>Open infrastructure</span><strong>Software, data, training, and shared methods</strong></div>
                    <div class="collective-fact"><span>Public science</span><strong>Conversations, educational tools, and science comics</strong></div>
                </div>
                <div class="action-row"><a class="text-action" href="/leadership" style="color:#fff;">Teaching and community <span aria-hidden="true">→</span></a></div>
            </div>
        </div>
        {% include '@theme/section-portrait.twig' %}
    </section>

    <section class="section teaching-section" aria-labelledby="teaching-title">
        <div class="teaching-grid shell">
            <div>
                <p class="eyebrow">Teaching &amp; mentoring</p>
                <h2 id="teaching-title">Teaching and supervision</h2>
                <p class="section-deck" style="margin-top:1.4rem;">In the classroom, in doctoral supervision, and through open computational tools, teaching, supervision, and open tools are part of the same work.</p>
                <div class="action-row"><a class="text-action" href="/leadership#public">See public engagement <span aria-hidden="true">→</span></a></div>
            </div>
            <div class="course-list">
                <article class="course-item">
                    <small>EPFL · CH-452</small>
                    <h3>Computational Methods in Molecular Quantum Mechanics</h3>
                    <p>Quantum time-dependent properties, density functional theory, and nuclear quantum effects.</p>
                </article>
                <article class="course-item">
                    <small>EPFL · PHYS-729</small>
                    <h3>Non-equilibrium Statistical Mechanics Simulations</h3>
                    <p>Formal results, computational algorithms, coding exercises, and the physics of open systems.</p>
                </article>
                <article class="course-item">
                    <small>Doctoral supervision</small>
                    <h3>Doctoral supervision</h3>
                    <p>Doctoral work connects method development, physical application, and the confidence to ask an original question.</p>
                </article>
            </div>
        </div>
        {% include '@theme/scientific-ornament.twig' with {
            ornament_kind: 'poiseuille',
            ornament_class: 'science-ornament--teaching',
            ornament_title: 'Plane Poiseuille flow',
            ornament_formula: 'u/Umax = 1 − (y/H)²',
            ornament_description: 'Pressure-driven laminar channel flow is fastest at the centre and vanishes at both walls.'
        } %}
    </section>

    <section class="section section--field" aria-labelledby="selected-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div><p class="eyebrow">Recent papers</p><h2 id="selected-title">Selected recent work</h2></div>
                <p class="section-deck">Three papers that connect molecular-scale physics, numerical method development, and scientific computing.</p>
            </div>
            <div class="selected-work">
                <article class="selected-paper">
                    <time>2025</time>
                    <div><h3>Electrically driven first-order phase transition of a 2D ionic crystal at the electrode/electrolyte interface</h3><p>Electrochemical interfaces · Proceedings of the National Academy of Sciences</p></div>
                    <a href="https://doi.org/10.1073/pnas.2520026122" target="_blank" rel="noopener">DOI ↗</a>
                </article>
                <article class="selected-paper">
                    <time>2025</time>
                    <div><h3>mass-zero constrained molecular dynamics for electrostatic interactions</h3><p>Scalable real-space electrostatics · Journal of Chemical Physics</p></div>
                    <a href="https://doi.org/10.1063/5.0283356" target="_blank" rel="noopener">DOI ↗</a>
                </article>
                <article class="selected-paper">
                    <time>2025</time>
                    <div><h3>A tale of two codes: CUDA vs OpenACC for mass-zero constrained dynamics</h3><p>High-performance scientific software · International Journal of High Performance Computing Applications</p></div>
                    <a href="https://doi.org/10.1177/10943420251331673" target="_blank" rel="noopener">DOI ↗</a>
                </article>
            </div>
            <div class="action-row"><a class="button" href="/publications">Browse selected publications</a><a class="text-action" href="https://orcid.org/0000-0003-4131-2513" target="_blank" rel="noopener">Open ORCID <span aria-hidden="true">↗</span></a></div>
        </div>
    </section>

    <section class="section personal-coda" aria-labelledby="personal-title">
        <div class="personal-coda__grid shell">
            <div><p class="eyebrow">Outside work</p><h2 class="personal-coda__line" id="personal-title">Opera, mountains, and Harry Potter.</h2></div>
            <dl class="personal-notes">
                <div><dt>Opera</dt><dd><em>Simon Boccanegra</em> and <em>Così fan tutte</em></dd></div>
                <div><dt>Hiking</dt><dd>In the mountains whenever possible</dd></div>
                <div><dt>Reading</dt><dd>The world of Harry Potter</dd></div>
            </dl>
        </div>
    </section>

    <section class="contact-invitation" aria-labelledby="contact-title">
        <div class="contact-invitation__grid shell">
            <div>
                <p class="eyebrow">Contact</p>
                <h2 id="contact-title">Get in touch</h2>
                <p>Research, speaking, supervision, teaching, or scientific-community work. Say what it is about and what you need.</p>
            </div>
            <a class="button" href="mailto:sara.bonella@epfl.ch?subject=Academic%20enquiry">Write to Sara</a>
        </div>
    </section>
{% endblock %}
