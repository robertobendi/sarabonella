{% extends '@theme/layout.twig' %}
{% set page_title = entry.field('title') ~ ' — Publication — Sara Bonella' %}
{% set meta_description = entry.field('abstract')|default('A publication by Sara Bonella and collaborators.', true) %}
{% set og_title = page_title %}
{% set og_description = meta_description %}
{% set body_class = 'page-publications' %}

{% block content %}
    {% set hero_kind = 'publications' %}
    {% set hero_canvas = true %}
    {% set hero_image = '/uploads/publications-hero/the_philosophical_magazine__a_journal_of_theoretical__experi.jpg' %}
    {% set hero_alt = 'A historic scientific journal plate with diagrams of experimental apparatus' %}
    {% set hero_caption = 'A page from The Philosophical Magazine · historical publishing context' %}
    {% set hero_source_url = '' %}
    {% set hero_eyebrow = 'Publication · ' ~ entry.field('year') %}
    {% set hero_title = entry.field('title') %}
    {% set hero_deck = entry.field('authors') %}
    {% set hero_roles = [entry.field('venue')|default('Peer-reviewed publication', true), entry.field('category')|default('Computational physics', true)] %}
    {% set hero_primary_url = entry.field('doi_url')|default('/publications', true) %}
    {% set hero_primary_label = entry.field('doi_url') ? 'Open the paper' : 'Selected publications' %}
    {% set hero_secondary_url = '/publications' %}
    {% set hero_secondary_label = 'Back to publications' %}
    {% include '@theme/orbital-hero.twig' %}

    <article class="article-shell">
        <section aria-labelledby="paper-details-title">
            <p class="eyebrow">About this paper</p>
            <h2 id="paper-details-title">Publication details</h2>
            <dl class="contact-details" style="margin-top:2rem;">
                <div><dt>Authors</dt><dd>{{ entry.field('authors') }}</dd></div>
                <div><dt>Venue</dt><dd>{{ entry.field('venue') }}</dd></div>
                <div><dt>Year</dt><dd>{{ entry.field('year') }}</dd></div>
                {% if entry.field('category') %}<div><dt>Research area</dt><dd>{{ entry.field('category') }}</dd></div>{% endif %}
            </dl>
        </section>
        {% if entry.field('abstract') %}
            <section class="article-body" style="margin-top:4rem;" aria-labelledby="paper-summary-title">
                <p class="eyebrow">Summary</p>
                <h2 id="paper-summary-title">Research abstract</h2>
                <p>{{ entry.field('abstract') }}</p>
            </section>
        {% endif %}
    </article>
{% endblock %}
