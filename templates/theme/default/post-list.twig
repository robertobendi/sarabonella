{% extends '@theme/layout.twig' %}
{% set page_title = 'Notes — Sara Bonella' %}
{% set meta_description = 'Occasional notes from Sara Bonella on computational physics, teaching, and scientific communities.' %}
{% set og_title = page_title %}
{% set og_description = meta_description %}
{% set body_class = 'page-default' %}

{% block content %}
    <section class="section section--field" aria-labelledby="notes-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div><p class="eyebrow">Notes</p><h1 id="notes-title">Occasional writing</h1></div>
                <p class="section-deck">Reflections on physical questions, computational methods, teaching, and the institutions that help science happen.</p>
            </div>
{% if posts|length == 0 %}
            <div class="thesis-panel"><h2>No public notes yet.</h2><p style="margin-top:1rem;">For current work, continue to Research or Publications.</p><div class="action-row"><a class="text-action" href="/research">Explore the research <span aria-hidden="true">→</span></a></div></div>
{% else %}
            <div class="selected-work">
                {% for post in posts %}
                    <article class="selected-paper">
                        <time>{{ (post.publishAt ?? post.createdAt)|date('Y') }}</time>
                        <div><h3>{{ post.field('title', '(untitled)') }}</h3>{% if post.field('excerpt') %}<p>{{ post.field('excerpt') }}</p>{% endif %}</div>
                        <a href="/blog/{{ post.slug }}">Read →</a>
                    </article>
                {% endfor %}
            </div>
{% endif %}
        </div>
    </section>
{% endblock %}
