{% extends '@theme/layout.twig' %}
{% set page_title = 'Research — Sara Bonella' %}
{% set meta_description = 'Explore Sara Bonella’s research in statistical physics, quantum dynamics, molecular simulation, and high-performance computing.' %}
{% set og_title = 'Research — Matter, motion, and computational methods' %}
{% set og_description = meta_description %}
{% set body_class = 'page-research' %}

{% block content %}
    {% set hero_kind = 'research' %}
    {% set hero_ring_text = 'RESEARCH • MATTER • MOTION • METHODS •' %}
    {% set hero_image = '/uploads/research-hero/dutch_national_supercomputer__huygens____8183833489_png.png' %}
    {% set hero_alt = 'Curved banks of the Dutch national Huygens supercomputer' %}
    {% set hero_caption = 'Huygens supercomputer — HPC context, not a claimed CECAM facility' %}
    {% set hero_source_url = 'https://commons.wikimedia.org/wiki/File:Dutch_National_Supercomputer_(Huygens)_(8183833489).png' %}
    {% set hero_eyebrow = '01 / RESEARCH TERRITORY' %}
    {% set hero_title = 'Simulation connects matter, motion, and non-equilibrium behaviour' %}
    {% set hero_deck = 'The central question is methodological and physical at once: how can computation preserve the structure of a system while making its inaccessible scales observable?' %}
    {% set hero_roles = ['Statistical & quantum physics', 'Molecular dynamics / condensed phases', 'Methods, software & high-performance computing'] %}
    {% set hero_primary_url = 'mailto:sara.bonella@epfl.ch?subject=Research%20collaboration' %}
    {% set hero_primary_label = 'Discuss collaboration' %}
    {% set hero_secondary_url = '#area-orbit' %}
    {% set hero_secondary_label = 'Choose a research area' %}
    {% set hero_nodes = [
        {'label': 'Statistical physics', 'url': '#statistical'},
        {'label': 'Quantum dynamics', 'url': '#quantum'},
        {'label': 'Molecular simulation', 'url': '#molecular'},
        {'label': 'HPC & infrastructure', 'url': '#hpc'},
        {'label': 'Scientific leadership', 'url': '#leadership', 'lime': true}
    ] %}
    {% include '@theme/orbital-hero.twig' %}

    <section class="section section--large" aria-labelledby="research-thesis-title">
        <div class="shell">
            <p class="eyebrow">02 / WORKING THESIS</p>
            <div class="thesis-panel">
                <h2 id="research-thesis-title">The model matters only when its physical assumptions remain visible.</h2>
                <p style="margin-top:1.5rem;">Bonella’s research develops and applies computational approaches for condensed-phase systems across statistical mechanics, approximate quantum dynamics, electrochemical interfaces, free-energy reconstruction, and charge transport. The emphasis is not calculation for its own sake: it is the disciplined connection between method, observable, and physical interpretation.</p>
            </div>
        </div>
    </section>

    <section class="section section--large section--field" id="area-orbit" aria-labelledby="area-orbit-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div>
                    <p class="eyebrow">03 / AREA ORBIT</p>
                    <h2 id="area-orbit-title">Five points of useful overlap</h2>
                </div>
                <p class="section-deck">Each territory is framed by a question, a method, and a reason it matters—enough for an expert reader to locate a genuine point of connection quickly.</p>
            </div>

            <div class="area-orbit">
                {% if entries|length > 0 %}
                    {% for item in entries %}
                        <article class="research-card area-entry accent-{% if loop.index is even %}pink{% else %}cyan{% endif %}" id="{{ item.slug }}">
                            <div class="card-meta"><span class="card-coordinate">R.{{ '%02d'|format(loop.index) }} / {{ item.field('category') }}</span><span>Current entry</span></div>
                            <h3>{{ item.field('title') }}</h3>
                            <p>{{ item.field('summary') }}</p>
                            <a class="card-link" href="/research/{{ item.slug }}">Open research note →</a>
                        </article>
                    {% endfor %}
                {% else %}
                    <article class="research-card area-entry accent-cyan" id="statistical">
                        <div class="card-meta"><span class="card-coordinate">R.01 / STATISTICAL</span><span>Non-equilibrium</span></div>
                        <h3>Statistical physics</h3>
                        <div class="question-method">
                            <p><strong>Question</strong><br>Which symmetries and constraints govern systems driven away from equilibrium?</p>
                            <p><strong>Method</strong><br>Statistical mechanics, fluctuation relations, constrained dynamics, and trajectory analysis.</p>
                            <p><strong>Why it matters</strong><br>Reliable simulation depends on knowing which relationships remain physical under forcing, magnetic fields, and scale separation.</p>
                        </div>
                    </article>

                    <article class="research-card area-entry accent-pink" id="quantum">
                        <div class="card-meta"><span class="card-coordinate">R.02 / QUANTUM</span><span>Approximation</span></div>
                        <h3>Approximate quantum dynamics</h3>
                        <div class="question-method">
                            <p><strong>Question</strong><br>How can nuclear quantum behaviour be retained without making realistic systems computationally unreachable?</p>
                            <p><strong>Method</strong><br>Wigner representations, quantum thermal baths, trajectory-based approximations, and correlation functions.</p>
                            <p><strong>Why it matters</strong><br>Practical approximations can connect formal quantum descriptions to spectra and condensed-phase observables.</p>
                        </div>
                    </article>

                    <article class="research-card area-entry accent-lime" id="molecular">
                        <div class="card-meta"><span class="card-coordinate">R.03 / MOLECULAR</span><span>Interfaces</span></div>
                        <h3>Molecular simulation</h3>
                        <div class="question-method">
                            <p><strong>Question</strong><br>How do electrochemical interfaces, active matter, and condensed phases evolve across coupled time and length scales?</p>
                            <p><strong>Method</strong><br>Molecular dynamics, mass-zero constraints, free-energy reconstruction, and multiscale modelling.</p>
                            <p><strong>Why it matters</strong><br>Well-designed algorithms expose mechanisms that experiments alone cannot resolve at atomistic scale.</p>
                        </div>
                    </article>

                    <article class="research-card area-entry accent-violet" id="hpc">
                        <div class="card-meta"><span class="card-coordinate">R.04 / HPC</span><span>Scale</span></div>
                        <h3>HPC &amp; scientific infrastructure</h3>
                        <div class="question-method">
                            <p><strong>Question</strong><br>What lets computational methods become reliable shared capability rather than isolated code?</p>
                            <p><strong>Method</strong><br>High-performance computing, community software, training platforms, and cross-institutional programmes.</p>
                            <p><strong>Why it matters</strong><br>Scientific progress at scale needs technical infrastructure and the human networks able to use it critically.</p>
                        </div>
                    </article>

                    <article class="research-card area-entry accent-pink" id="leadership">
                        <div class="card-meta"><span class="card-coordinate">R.05 / LEADERSHIP</span><span>Communities</span></div>
                        <h3>Scientific programme leadership</h3>
                        <div class="question-method">
                            <p><strong>Question</strong><br>How can emerging research communities build shared agendas without flattening disciplinary differences?</p>
                            <p><strong>Method</strong><br>Scientific programmes, workshops, networks, funding coordination, teaching, and international partnership.</p>
                            <p><strong>Why it matters</strong><br>Ambitious computational science is sustained by institutions that connect expertise, resources, and new researchers.</p>
                        </div>
                    </article>
                {% endif %}
            </div>
        </div>
    </section>

    <section class="section section--large" aria-labelledby="methods-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div>
                    <p class="eyebrow">04 / METHODS &amp; INFRASTRUCTURE</p>
                    <h2 id="methods-title">A molecular field, not a black box</h2>
                </div>
                <p class="section-deck">Equations and trajectories can carry atmosphere here; the evidence remains selectable text. The methods are described without implying live data, proprietary access, or results beyond the supplied record.</p>
            </div>
            <div class="molecular-field">
                <svg viewBox="0 0 1200 540" preserveAspectRatio="none" aria-hidden="true">
                    <defs>
                        <pattern id="particle-grid" width="42" height="42" patternUnits="userSpaceOnUse">
                            <circle cx="8" cy="12" r="3" fill="#00D9FF"/><circle cx="31" cy="28" r="2" fill="#FF4FCB"/>
                        </pattern>
                    </defs>
                    <rect width="1200" height="540" fill="url(#particle-grid)" opacity=".54"/>
                    <g class="trajectory" color="#00D9FF"><path d="M0 360 C190 80 320 510 520 220 S840 60 1200 300"/><path d="M0 180 C240 420 410 40 660 310 S980 500 1200 130"/></g>
                    <g fill="none" stroke="#B8FF3E" opacity=".7"><ellipse cx="610" cy="270" rx="330" ry="110"/><ellipse cx="610" cy="270" rx="235" ry="72"/><ellipse cx="610" cy="270" rx="135" ry="39"/></g>
                </svg>
                <div class="method-grid">
                    <article class="method-chip"><p class="eyebrow">M.01</p><h3>Molecular dynamics</h3><p>Atomistic trajectories and constrained formulations for complex condensed systems.</p></article>
                    <article class="method-chip"><p class="eyebrow">M.02</p><h3>Statistical mechanics</h3><p>Physical structure, non-equilibrium relations, and interpretable ensemble behaviour.</p></article>
                    <article class="method-chip"><p class="eyebrow">M.03</p><h3>Quantum dynamics</h3><p>Approximate trajectory methods for quantum effects and time-dependent observables.</p></article>
                    <article class="method-chip"><p class="eyebrow">M.04</p><h3>High-performance computing</h3><p>Scalable implementation, software, training, and shared research infrastructure.</p></article>
                </div>
            </div>
        </div>
    </section>

    <section class="section section--large section--plum" aria-labelledby="selected-work-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div>
                    <p class="eyebrow">05 / SELECTED WORK</p>
                    <h2 id="selected-work-title">Methods made visible in papers</h2>
                </div>
                <p class="section-deck">A short bridge from research territory to durable publication records. DOI exits remain visible and do not depend on hover.</p>
            </div>
            <div class="evidence-grid">
                <article class="publication-card accent-lime">
                    <div class="card-meta"><span class="card-coordinate">2025 / MOLECULAR</span><span>JCP 163</span></div>
                    <h3>Mass-zero constrained molecular dynamics for electrostatic interactions</h3>
                    <p class="paper-authors">Troni, Grassano, Narayan, Roux &amp; Bonella</p>
                    <a class="card-link" href="https://doi.org/10.1063/5.0283356" target="_blank" rel="noopener">Open DOI →</a>
                </article>
                <article class="publication-card accent-cyan">
                    <div class="card-meta"><span class="card-coordinate">2023 / STATISTICAL</span><span>JCP 159</span></div>
                    <h3>Inferring free-energy barriers and kinetic rates from molecular dynamics</h3>
                    <p class="paper-authors">Girardier, Vroylandt, Bonella &amp; Pietrucci</p>
                    <a class="card-link" href="https://doi.org/10.1063/5.0169050" target="_blank" rel="noopener">Open DOI →</a>
                </article>
                <article class="publication-card accent-pink">
                    <div class="card-meta"><span class="card-coordinate">2021 / NON-EQUILIBRIUM</span><span>Entropy 23</span></div>
                    <h3>Fluctuation relations for dissipative systems in a constant magnetic field</h3>
                    <p class="paper-authors">Coretti, Rondoni &amp; Bonella</p>
                    <a class="card-link" href="https://doi.org/10.3390/e23020146" target="_blank" rel="noopener">Open DOI →</a>
                </article>
            </div>
            <div class="action-row" style="margin-top:2.5rem;"><a class="button" href="/publications">Explore selected publications <span class="arrow-glyph" aria-hidden="true">↗</span></a></div>
        </div>
    </section>

    <section class="section section--large" aria-labelledby="research-contact-title">
        <div class="shell">
            <div class="invitation-panel">
                <div>
                    <p class="eyebrow">06 / ORBIT CLOSURE</p>
                    <h2 id="research-contact-title">Bring a method, a system, or a difficult scale.</h2>
                    <p class="section-deck">The most useful first message names the physical question, the computational obstacle, and the kind of exchange you have in mind.</p>
                    <div class="action-row" style="margin-top:2rem;"><a class="button" href="mailto:sara.bonella@epfl.ch?subject=Research%20collaboration">Discuss collaboration <span class="arrow-glyph" aria-hidden="true">↗</span></a></div>
                </div>
                <span class="sticker sticker--lime" aria-hidden="true">
                    <svg viewBox="0 0 120 120"><defs><path id="research-seal-ring" d="M60 60m-48 0a48 48 0 1 1 96 0a48 48 0 1 1-96 0"/></defs><circle cx="60" cy="60" r="53" fill="#070A18" stroke="currentColor" stroke-width="2"/><text font-size="10" letter-spacing="1.8"><textPath href="#research-seal-ring">COLLABORATE • RESEARCH • </textPath></text><text x="60" y="68" text-anchor="middle" font-size="24" font-weight="700">R↗</text></svg>
                </span>
            </div>
        </div>
    </section>
{% endblock %}
