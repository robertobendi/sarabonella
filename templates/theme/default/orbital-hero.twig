<section class="orbital-hero hero--{{ hero_kind }}" aria-labelledby="hero-title-{{ hero_kind }}">
    <div class="hero-grid">
        <div class="orbital-visual">
            <div class="orbit-disc">
                <span class="stage-halo" aria-hidden="true"></span>
                <svg class="orbit-svg" viewBox="0 0 1000 1000" aria-hidden="true">
                    <defs>
                        <path id="ring-path-{{ hero_kind }}" d="M500,500 m-430,0 a430,430 0 1,1 860,0 a430,430 0 1,1 -860,0"/>
                    </defs>
                    <circle class="orbit-guide" cx="500" cy="500" r="430"/>
                    <circle class="orbit-guide orbit-guide--inner" cx="500" cy="500" r="310"/>
                    <g class="orbit-rotor">
                        <text class="orbit-copy orbit-copy--violet" textLength="2670" lengthAdjust="spacingAndGlyphs"><textPath href="#ring-path-{{ hero_kind }}">{{ hero_ring_text }}</textPath></text>
                        <text class="orbit-copy orbit-copy--cyan" textLength="2670" lengthAdjust="spacingAndGlyphs"><textPath href="#ring-path-{{ hero_kind }}">{{ hero_ring_text }}</textPath></text>
                        <text class="orbit-copy" textLength="2670" lengthAdjust="spacingAndGlyphs"><textPath href="#ring-path-{{ hero_kind }}">{{ hero_ring_text }}</textPath></text>
                    </g>
                </svg>

                <figure class="hero-aperture">
                    <img src="{{ hero_image }}" alt="{{ hero_alt }}">
                    <figcaption class="aperture-caption">
                        {{ hero_caption }}
                        {% if hero_source_url %} · <a href="{{ hero_source_url }}" target="_blank" rel="noopener">Wikimedia source</a>{% endif %}
                    </figcaption>
                </figure>

                {% for node in hero_nodes %}
                    <a class="orbit-node node--{{ loop.index }}{% if node.lime|default(false) %} orbit-node--lime{% endif %}" href="{{ node.url }}">{{ node.label }}</a>
                {% endfor %}

                {% if hero_kind == 'publications' %}
                    <span class="citation-tab citation-tab--1">DOI / linked</span>
                    <span class="citation-tab citation-tab--2">Peer reviewed</span>
                    <span class="citation-tab citation-tab--3">1996—2026</span>
                {% endif %}
            </div>
        </div>

        <div class="hero-panel">
            <p class="eyebrow">{{ hero_eyebrow }}</p>
            <h1 id="hero-title-{{ hero_kind }}">{{ hero_title }}</h1>
            <p class="hero-deck">{{ hero_deck }}</p>
            {% if hero_roles|length > 0 %}
                <ul class="role-lines">
                    {% for role in hero_roles %}<li>{{ role }}</li>{% endfor %}
                </ul>
            {% endif %}
            <div class="action-row">
                <a class="button" href="{{ hero_primary_url }}">{{ hero_primary_label }} <span class="arrow-glyph" aria-hidden="true">↗</span></a>
                {% if hero_secondary_url %}<a class="text-action" href="{{ hero_secondary_url }}">{{ hero_secondary_label }}</a>{% endif %}
            </div>
        </div>
    </div>
    <svg class="hero-exit-trajectory trajectory" viewBox="0 0 760 190" preserveAspectRatio="none" aria-hidden="true">
        <path d="M760 18 C620 12 590 88 462 88 S260 56 208 126 S74 178 0 160"/>
        <circle cx="462" cy="88" r="7"/>
        <circle cx="208" cy="126" r="5"/>
    </svg>
</section>
