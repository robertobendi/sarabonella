{% set hero_uses_simulation = hero_canvas|default(false) %}
<section class="page-intro hero--{{ hero_kind }}"{% if hero_uses_simulation %} data-langevin-surface{% endif %} aria-labelledby="hero-title-{{ hero_kind }}">
    <div class="page-intro__grid shell">
        <div class="hero-panel">
            <p class="eyebrow">{{ hero_eyebrow }}</p>
            <h1 id="hero-title-{{ hero_kind }}">{{ hero_title }}</h1>
            <p class="hero-deck">{{ hero_deck }}</p>

{% if hero_roles|length > 0 %}
            <ul class="role-lines">
                {% for role in hero_roles %}<li>{{ role }}</li>{% endfor %}
            </ul>
{% endif %}

            <div class="action-row">
                <a class="button" href="{{ hero_primary_url }}">{{ hero_primary_label }}</a>
                {% if hero_secondary_url %}<a class="text-action" href="{{ hero_secondary_url }}">{{ hero_secondary_label }} <span aria-hidden="true">→</span></a>{% endif %}
            </div>
        </div>

        <figure class="page-intro__media{% if hero_uses_simulation %} page-intro__media--simulation{% endif %}">
{% if hero_uses_simulation %}
            {% include '@theme/hero-field.twig' with { field_kind: hero_field|default('wavepacket') } %}
{% else %}
            <img src="{{ hero_image }}" alt="{{ hero_alt }}">
{% endif %}
            <figcaption>
{% if hero_uses_simulation %}
                {{ hero_simulation_caption }}
                {% if hero_simulation_source_url %} · <a href="{{ hero_simulation_source_url }}" target="_blank" rel="noopener">{{ hero_simulation_source_label|default('Research basis') }}</a>{% endif %}
{% else %}
                {{ hero_caption }}
                {% if hero_source_url %} · <a href="{{ hero_source_url }}" target="_blank" rel="noopener">Image source</a>{% endif %}
{% endif %}
            </figcaption>
        </figure>
    </div>
</section>
