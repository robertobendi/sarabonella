{% set hero_uses_simulation = hero_canvas|default(false) %}
{#
    With a live field the hero runs full-bleed behind the copy, the way the home
    page does; with a still image it keeps the two-column layout, since a
    photograph needs its own frame and caption.
#}
<section class="page-intro hero--{{ hero_kind }}{% if hero_uses_simulation %} page-intro--immersive{% endif %}"{% if hero_uses_simulation %} data-langevin-surface{% endif %} aria-labelledby="hero-title-{{ hero_kind }}">
    <div class="page-intro__grid shell">
        <div class="hero-panel">
            <p class="eyebrow">{{ hero_eyebrow }}</p>
            <h1 id="hero-title-{{ hero_kind }}">{{ hero_title }}</h1>
            <p class="hero-deck">{{ hero_deck }}</p>

{% if hero_roles|length > 0 %}
            <ul class="role-lines">
                {% for role in hero_roles %}<li>{{ role }}</li>{% endfor %}
            </ul>
{% endif %}

            <div class="action-row">
                <a class="button" href="{{ hero_primary_url }}">{{ hero_primary_label }}</a>
                {% if hero_secondary_url %}<a class="text-action" href="{{ hero_secondary_url }}">{{ hero_secondary_label }} <span aria-hidden="true">→</span></a>{% endif %}
            </div>
        </div>

{% if not hero_uses_simulation %}
        <figure class="page-intro__media">
            <img src="{{ hero_image }}" alt="{{ hero_alt }}">
            <figcaption>
                {{ hero_caption }}
                {% if hero_source_url %} · <a href="{{ hero_source_url }}" target="_blank" rel="noopener">Image source</a>{% endif %}
            </figcaption>
        </figure>
{% endif %}
    </div>
{% if hero_uses_simulation %}

{% if hero_photo %}
    {# A photograph behind the field: big, cropped by the frame, monochrome, and
       faded out across the column the copy occupies. #}
    <figure class="hero-photo" aria-hidden="true">
        <img src="/uploads/heroes/{{ hero_photo }}" alt="" loading="lazy" decoding="async" style="object-position: {{ hero_photo_position|default('62% 50%') }};">
    </figure>
{% endif %}

    <figure class="hero-simulation">
        {% include '@theme/hero-field.twig' with { field_kind: hero_field|default('wavepacket') } %}
        {# Credits only: the field speaks for itself, and the model is named in
           the notation along the bottom edge. #}
        <figcaption>
            {% if hero_simulation_source_url %}<a href="{{ hero_simulation_source_url }}" target="_blank" rel="noopener">{{ hero_simulation_source_label|default('Research basis') }}</a>{% endif %}
            {% if hero_photo_source_url %}{% if hero_simulation_source_url %} · {% endif %}<a href="{{ hero_photo_source_url }}" target="_blank" rel="noopener">{{ hero_photo_label|default('Photograph') }}</a>{% endif %}
        </figcaption>
    </figure>
{% endif %}
</section>
