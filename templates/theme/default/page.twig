{% extends '@theme/layout.twig' %}
{% set page_title = entry.field('title') ~ ' — Sara Bonella' %}
{% set meta_description = entry.field('meta_description')|default(entry.field('summary')|default('Research, teaching, and scientific community work from Sara Bonella.'), true) %}
{% set og_title = page_title %}
{% set og_description = meta_description %}
{% set body_class = 'page-default' %}

{% block content %}
    {% set hero_kind = 'page' %}
    {% set hero_canvas = not entry.field('lead_image') %}
    {% set hero_image = entry.field('lead_image')|default('/uploads/portrait/sara-bonella-seated.jpg', true) %}
    {% set hero_alt = 'Context image for ' ~ entry.field('title') %}
    {% set hero_caption = entry.field('lead_image') ? entry.field('title') : 'Portrait from the NCCR MARVEL profile' %}
    {% set hero_source_url = entry.field('lead_image') ? '' : 'https://nccr-marvel.ch/outreach/equal-opportunities/women-profiles/sara-bonella' %}
    {% set hero_eyebrow = 'Sara Bonella' %}
    {% set hero_title = entry.field('title') %}
    {% set hero_deck = entry.field('summary')|default('Research, teaching, and scientific communities connected through careful computational work.', true) %}
    {% set hero_roles = [] %}
    {% set hero_primary_url = '/contact' %}
    {% set hero_primary_label = 'Start a conversation' %}
    {% set hero_secondary_url = '/research' %}
    {% set hero_secondary_label = 'Explore the research' %}
    {% include '@theme/orbital-hero.twig' %}

    <article class="article-shell">
        <div class="article-body">{{ entry.field('body')|markdown }}</div>
    </article>
{% endblock %}
