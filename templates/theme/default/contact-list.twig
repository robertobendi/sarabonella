{% extends '@theme/layout.twig' %}
{% set page_title = 'Contact — Sara Bonella' %}
{% set meta_description = 'Contact Sara Bonella about research, speaking, teaching, supervision, or scientific-community work at EPFL and CECAM.' %}
{% set og_title = page_title %}
{% set og_description = meta_description %}
{% set body_class = 'page-contact' %}

{% block content %}
    {% set hero_kind = 'contact' %}
    {% set hero_canvas = true %}
    {% set hero_field = 'ripple' %}
    {% set hero_simulation_title = 'Wave from a source' %}
    {% set hero_simulation_caption = 'A wave spreading from one point. Move the pointer to place the source; tap or press Enter to send another.' %}
    {% set hero_ring_text = '' %}
    {% set hero_image = '/uploads/portrait/sara-bonella-seated.jpg' %}
    {% set hero_alt = 'Sara Bonella seated in front of a whiteboard covered with equations' %}
    {% set hero_caption = 'Portrait from the NCCR MARVEL profile' %}
    {% set hero_source_url = 'https://nccr-marvel.ch/outreach/equal-opportunities/women-profiles/sara-bonella' %}
    {% set hero_eyebrow = 'Contact · Lausanne' %}
    {% set hero_title = 'Start with the question you want to explore' %}
    {% set hero_deck = 'Research, speaking, teaching, supervision, and scientific-community enquiries can begin directly by email.' %}
    {% set hero_roles = ['Senior Scientist / EPFL', 'Deputy Director / CECAM', 'Direct email / no contact form'] %}
    {% set hero_primary_url = 'mailto:sara.bonella@epfl.ch?subject=Academic%20enquiry' %}
    {% set hero_primary_label = 'Write to Sara' %}
    {% set hero_secondary_url = '#details' %}
    {% set hero_secondary_label = 'Contact details' %}
    {% set hero_nodes = [] %}
    {% include '@theme/orbital-hero.twig' %}

    <section class="section" id="details" aria-labelledby="details-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div><p class="eyebrow">Direct contact</p><h2 id="details-title">One clear route</h2></div>
                <p class="section-deck">A short message is enough. Include the purpose, the relevant scientific or institutional context, and the next decision you would like to make together.</p>
            </div>

            <div class="contact-readout">
                <div>
                    <p class="eyebrow">Email</p>
                    <a class="email-readout" href="mailto:sara.bonella@epfl.ch?subject=Academic%20enquiry">sara.bonella@epfl.ch</a>
                    <p class="source-note" style="margin-top:1rem;"><a href="https://people.epfl.ch/sara.bonella?lang=en" target="_blank" rel="noopener">Confirmed by the EPFL people directory →</a></p>
                </div>
                <dl class="contact-details">
                    <div><dt>Telephone</dt><dd><a href="tel:+41216931979">+41 21 693 19 79</a></dd></div>
                    <div><dt>Office</dt><dd>BCH 3102 · EPFL</dd></div>
                    <div><dt>Post</dt><dd>EPFL CECAM · BCH 3103<br>Avenue de Forel 3<br>CH-1015 Lausanne, Switzerland</dd></div>
                    <div><dt>Profiles</dt><dd><a href="https://people.epfl.ch/sara.bonella?lang=en" target="_blank" rel="noopener">EPFL</a> · <a href="https://orcid.org/0000-0003-4131-2513" target="_blank" rel="noopener">ORCID</a> · <a href="https://www.cecam.org/lausanne-hq" target="_blank" rel="noopener">CECAM</a></dd></div>
                </dl>
            </div>
        </div>
    </section>

    <section class="section section--field section--ornamented" aria-labelledby="context-title">
        <div class="teaching-grid shell">
            <div>
                <p class="eyebrow">Helpful context</p>
                <h2 id="context-title">What to include</h2>
                <p class="section-deck" style="margin-top:1.4rem;">Choose the closest starting point. There is no special format and no information is collected by this website.</p>
            </div>
            <div class="course-list">
                <article class="course-item"><small>Research</small><h3>The physical question and the computational challenge</h3></article>
                <article class="course-item"><small>Speaking</small><h3>Audience, format, scientific theme, place, and likely date</h3></article>
                <article class="course-item"><small>Teaching or supervision</small><h3>Your background, topic, timing, and the kind of guidance you seek</h3></article>
                <article class="course-item"><small>Programmes and institutions</small><h3>The community, proposed role, and the decision the conversation should support</h3></article>
            </div>
        </div>
        {% include '@theme/scientific-ornament.twig' with {
            ornament_kind: 'vortex',
            ornament_class: 'science-ornament--right',
            ornament_title: 'Taylor–Green vortices',
            ornament_formula: '∇·u = 0',
            ornament_description: 'Passive tracers circulate through a periodic incompressible velocity field.'
        } %}
    </section>

    <section class="contact-invitation" aria-labelledby="write-title">
        <div class="contact-invitation__grid shell">
            <div><p class="eyebrow">Correspondence</p><h2 id="write-title">Ready when the question is.</h2><p>Email actions open your own mail application. This site uses no contact form, cookies, or personal analytics identifiers.</p></div>
            <a class="button" href="mailto:sara.bonella@epfl.ch?subject=Academic%20enquiry">Open an email</a>
        </div>
    </section>
{% endblock %}
