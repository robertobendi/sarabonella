{% extends '@theme/layout.twig' %}
{% set page_title = 'Publications — Sara Bonella' %}
{% set meta_description = 'Selected publications by Sara Bonella in molecular simulation, statistical physics, quantum dynamics, electrochemistry, and scientific computing.' %}
{% set og_title = 'Selected publications — Sara Bonella' %}
{% set og_description = meta_description %}
{% set body_class = 'page-publications' %}

{% block content %}
    {% set hero_kind = 'publications' %}
    {% set hero_canvas = true %}
    {% set hero_field = 'interference' %}
    {% set hero_simulation_title = 'Two-slit interference' %}
    {% set hero_simulation_caption = 'Detections land one at a time and the fringes build up from them. Move the pointer to change the slit separation.' %}
    {% set hero_simulation_source_url = 'https://orcid.org/0000-0003-4131-2513' %}
    {% set hero_simulation_source_label = 'Full record' %}
    {% set hero_image = '/uploads/publications-hero/the_philosophical_magazine__a_journal_of_theoretical__experi.jpg' %}
    {% set hero_alt = 'A historic scientific journal plate with diagrams of experimental apparatus' %}
    {% set hero_caption = 'A page from The Philosophical Magazine · historical publishing context' %}
    {% set hero_source_url = 'https://commons.wikimedia.org/wiki/Special:MediaSearch?type=image&search=The%20Philosophical%20Magazine%20journal%20theoretical%20experimental' %}
    {% set hero_eyebrow = 'Selected publications' %}
    {% set hero_title = 'Ideas developed in company' %}
    {% set hero_deck = 'Sara’s publication record follows long-running collaborations across molecular simulation, mathematical physics, electrochemistry, open tools, and high-performance computing.' %}
    {% set hero_roles = ['Methods and physical applications', 'Collaborative, peer-reviewed work', 'Full record available through ORCID'] %}
    {% set hero_primary_url = '#selected-papers' %}
    {% set hero_primary_label = 'Read the selection' %}
    {% set hero_secondary_url = 'https://orcid.org/0000-0003-4131-2513' %}
    {% set hero_secondary_label = 'Open ORCID' %}
    {% include '@theme/orbital-hero.twig' %}

    <section class="section section--field" id="selected-papers" aria-labelledby="selected-papers-title">
        <div class="shell">
            <div class="section-heading section-heading--split">
                <div><p class="eyebrow">A curated record</p><h2 id="selected-papers-title">Places to begin</h2></div>
                <p class="section-deck">Selected for the way they trace recurring questions in Sara’s work—not as a ranking, but as an invitation into the research.</p>
            </div>
            {% set selected_entries = entries|filter(item => item.field('featured')) %}
            {% if selected_entries|length == 0 %}{% set selected_entries = entries|slice(0, 8) %}{% endif %}
            <div class="selected-work">
{% if selected_entries|length > 0 %}
                {% for item in selected_entries %}
                    <article class="selected-paper">
                        <time>{{ item.field('year') }}</time>
                        <div><h3>{{ item.field('title') }}</h3><p>{{ item.field('authors') }} · {{ item.field('venue') }}</p></div>
                        {% if item.field('doi_url') %}<a href="{{ item.field('doi_url') }}" target="_blank" rel="noopener">DOI ↗</a>{% else %}<a href="/publications/{{ item.slug }}">Details →</a>{% endif %}
                    </article>
                {% endfor %}
{% else %}
                <article class="selected-paper">
                    <time>2025</time>
                    <div><h3>Electrically driven first-order phase transition of a 2D ionic crystal at the electrode/electrolyte interface</h3><p>F. Angiolari, A. Coretti, M. Salanne &amp; S. Bonella · PNAS 122</p></div>
                    <a href="https://doi.org/10.1073/pnas.2520026122" target="_blank" rel="noopener">DOI ↗</a>
                </article>
                <article class="selected-paper">
                    <time>2025</time>
                    <div><h3>mass-zero constrained molecular dynamics for electrostatic interactions</h3><p>F. Troni, D. Grassano, J. Narayan, B. Roux &amp; S. Bonella · The Journal of Chemical Physics 163</p></div>
                    <a href="https://doi.org/10.1063/5.0283356" target="_blank" rel="noopener">DOI ↗</a>
                </article>
                <article class="selected-paper">
                    <time>2025</time>
                    <div><h3>A tale of two codes: CUDA vs OpenACC for mass-zero constrained dynamics</h3><p>A. Vignolo et al. · International Journal of High Performance Computing Applications</p></div>
                    <a href="https://doi.org/10.1177/10943420251331673" target="_blank" rel="noopener">DOI ↗</a>
                </article>
                <article class="selected-paper">
                    <time>2024</time>
                    <div><h3>Jupyter widgets and extensions for education and research in computational physics and chemistry</h3><p>D. Du et al. · Computer Physics Communications 305</p></div>
                    <a href="https://doi.org/10.1016/j.cpc.2024.109353" target="_blank" rel="noopener">DOI ↗</a>
                </article>
                <article class="selected-paper">
                    <time>2023</time>
                    <div><h3>Inferring free-energy barriers and kinetic rates from molecular dynamics via underdamped Langevin models</h3><p>D. Girardier, H. Vroylandt, S. Bonella &amp; F. Pietrucci · The Journal of Chemical Physics 159</p></div>
                    <a href="https://doi.org/10.1063/5.0169050" target="_blank" rel="noopener">DOI ↗</a>
                </article>
                <article class="selected-paper">
                    <time>2023</time>
                    <div><h3>OSSCAR, an open platform for collaborative development of computational tools for education in science</h3><p>D. Du, T. J. Baird, S. Bonella &amp; G. Pizzi · Computer Physics Communications 282</p></div>
                    <a href="https://doi.org/10.1016/j.cpc.2022.108546" target="_blank" rel="noopener">DOI ↗</a>
                </article>
{% endif %}
            </div>
        </div>
    </section>

    <section class="section section--ornamented" aria-labelledby="threads-title">
        <div class="research-feature__grid shell">
            <div>
                <p class="eyebrow">Across the record</p>
                <h2 id="threads-title">The questions travel between fields</h2>
                <div class="question-list">
                    <article class="question-row"><span>01</span><div><h3>Approximation with structure</h3><p>Quantum and classical descriptions meet through algorithms designed to preserve the physical relationships that matter.</p></div></article>
                    <article class="question-row"><span>02</span><div><h3>Interfaces and non-equilibrium matter</h3><p>Charged surfaces, transport, rare events, and phase behaviour reveal how microscopic organisation creates macroscopic response.</p></div></article>
                    <article class="question-row"><span>03</span><div><h3>Methods that other people can use</h3><p>Open computational tools, shared APIs, training, and scalable code extend a method beyond the paper that introduced it.</p></div></article>
                </div>
            </div>
            <aside class="research-study" aria-labelledby="record-title">
                <p class="eyebrow">Full scholarly record</p>
                <h3 id="record-title">ORCID 0000-0003-4131-2513</h3>
                <p class="section-deck" style="margin-top:1rem;">For the complete and evolving bibliography, use Sara’s persistent researcher identifier.</p>
                <div class="action-row"><a class="button" href="https://orcid.org/0000-0003-4131-2513" target="_blank" rel="noopener">Open ORCID</a></div>
            </aside>
        </div>
        {% include '@theme/scientific-ornament.twig' with {
            ornament_kind: 'vortex',
            ornament_class: 'science-ornament--left',
            ornament_title: 'Taylor–Green vortices',
            ornament_formula: '∇·u = 0',
            ornament_description: 'Passive tracers circulate through a periodic incompressible velocity field.'
        } %}
    </section>

    <section class="contact-invitation" aria-labelledby="publication-contact-title">
        <div class="contact-invitation__grid shell">
            <div><p class="eyebrow">Continue the work</p><h2 id="publication-contact-title">A paper can begin a new conversation.</h2><p>Name the result, method, or physical question you would like to discuss, and the context in which the exchange would be useful.</p></div>
            <a class="button" href="mailto:sara.bonella@epfl.ch?subject=Publication%20or%20seminar%20enquiry">Write to Sara</a>
        </div>
    </section>
{% endblock %}
